# Tên miền của web sau khi deploy. Mã QR sẽ trỏ tới SITE_URL/hv/<mã>/
# Chốt trước khi in: QR đã in thì không sửa được.
SITE_URL=https://ten-mien-cua-ban.vn

# Mã xem: bấm con mắt trên trang + nhập mã này để xem đầy đủ CCCD, điện thoại, thường trú.
# Ít nhất 8 ký tự, nên trộn chữ và số. Chỉ đưa cho ban quản lý/HLV.
# Đổi mã: sửa ở đây, chạy lại `npm run import`, rồi deploy.
VIEW_CODE=
